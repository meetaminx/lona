# Public URL of this deployment, used for checkout and payment link URLs.
APP_URL=https://pay.yourdomain.com

# Postgres (Neon or any Postgres). Leave unset locally to use the embedded database in .data/.
DATABASE_URL=

# Protects /api/cron/tick. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=

# NEAR Intents 1Click. A JWT puts you on the authenticated fee schedule (request one from NEAR Intents).
ONECLICK_JWT=
ONECLICK_CONFIDENTIALITY=basic
ONECLICK_SLIPPAGE_BPS=100

# Lona's fee, added to the customer's quote. 50 = 0.5%. Paid to this NEAR account through 1Click app fees.
LONA_FEE_BPS=50
LONA_FEE_RECIPIENT=

# How long a ZEC price is held at checkout, in minutes.
LONA_QUOTE_TTL_MIN=20

# Test mode ZEC price in USD (not a market price).
# Test mode uses the live ZEC price. Set this only to pin a fixed test price.
# SANDBOX_ZEC_USD=1300

# Shown on the site and legal pages.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Email (password reset, email confirmation, customer receipts) through Resend.
# Without a key, emails are logged and, in development only, links are shown on screen.
RESEND_API_KEY=
MAIL_FROM="Lona <no-reply@yourdomain.com>"

# Requests per minute per API key.
API_RATE_PER_MIN=120

# Local development only: lets webhooks reach localhost. Never set in production.
ALLOW_PRIVATE_WEBHOOKS=

# Sign-in protection (optional overrides; defaults shown)
# AUTH_LOGIN_EMAIL_LIMIT=5
# AUTH_LOGIN_IP_LIMIT=30
# AUTH_FORGOT_EMAIL_LIMIT=3
# AUTH_FORGOT_IP_LIMIT=10
# AUTH_SIGNUP_IP_LIMIT=10
